# Copy this file to deploy/.env and adjust. Docker Compose auto-loads deploy/.env for ${VAR} substitution.

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Postgres / pgvector (RAG default vector store)
PG_USER=ai
PG_PASSWORD=change-me
PG_DB=rag

# LLM provider secrets (only needed for the connections you enable)
# OpenAI (api.openai.com)
OPENAI_API_KEY=

# Azure OpenAI — set these to use the `azure-openai` connection in llm.example.yaml
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock
AWS_REGION=us-east-1

# Keycloak dev admin (used with the `keycloak` profile)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
